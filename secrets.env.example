# Copy to /opt/minecraft/secrets.env on the server (chmod 600, owner minecraft).
# Never commit the real file. Values are substituted into ${VAR} placeholders at deploy time.
# mc-deploy generates empty ones; "manual" ones must be added by hand.
RCON_PASSWORD=
MANAGEMENT_SERVER_SECRET=
# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=manual
