# Public web on port 8100: BlueMap plus the nightly world download.
# BlueMap itself listens on 127.0.0.1:8101 (plugins/BlueMap/webserver.conf).
:8100 {
	redir /world /world/

	handle_path /world/* {
		root * /var/www/world
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8101
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
