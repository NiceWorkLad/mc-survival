[Unit]
Description=Post the daily Minecraft leaderboard to Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Player save files are only readable by the server's user
User=minecraft
ExecStart=/usr/local/bin/mc-leaderboard
EnvironmentFile=/opt/minecraft/secrets.env
Environment=LEADERBOARD_CHANNEL=1562950547298852929
# The last 8 days of totals, to rank the week's gains (/var/lib/mc-leaderboard/state.json)
StateDirectory=mc-leaderboard
