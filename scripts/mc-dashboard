#!/usr/bin/env python3
"""Home-network dashboard for the survival server: who's online, recent players,
every player's stats, and an activity feed (joins, deaths, advancements, chat).

Everything comes from files the server already writes (logs/, usercache.json,
world/players/stats, Essentials userdata) plus a status ping to 127.0.0.1:25565,
so it needs no plugin and no RCON. Only answers clients on private addresses;
the firewall also limits the port to the LAN.

  mc-dashboard                 serve on 0.0.0.0:8200
  mc-dashboard --port 8300     another port
  mc-dashboard --dump          print the JSON once and exit

Run by mc-dashboard.service as the minecraft user (player files are only readable by it).
"""
import argparse, datetime as dt, gzip, ipaddress, json, os, re, socket, struct, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LIVE = "/opt/minecraft/survival"
WORLD = f"{LIVE}/world"
LOGS = f"{LIVE}/logs"
WORLD_ZIP = "/var/www/world/survival-world.zip"
SERVICE = "minecraft-survival.service"
FEED = 200      # events sent to the page
DAYS = 30       # days in the activity chart
CACHE = 10      # seconds a snapshot is reused


# --- Status ping -------------------------------------------------------------

def varint(n):
    n &= 0xFFFFFFFF
    out = b""
    while True:
        b, n = n & 0x7F, n >> 7
        out += bytes([b | (0x80 if n else 0)])
        if not n:
            return out


def ping(host="127.0.0.1", port=25565):
    """Server list ping: version, player count and up to 12 sample names."""
    with socket.create_connection((host, port), timeout=3) as s:
        h = host.encode()
        hs = varint(0) + varint(-1) + varint(len(h)) + h + struct.pack(">H", port) + varint(1)
        s.sendall(varint(len(hs)) + hs + b"\x01\x00")
        f = s.makefile("rb")

        def rv():
            n = shift = 0
            while True:
                b = f.read(1)
                if not b:
                    raise ConnectionError("closed")
                n |= (b[0] & 0x7F) << shift; shift += 7
                if not b[0] & 0x80:
                    return n
        rv(); rv()  # packet length, id
        return json.loads(f.read(rv()))


# --- Logs --------------------------------------------------------------------

LINE = re.compile(r"^\[(\d\d):(\d\d):(\d\d)\] \[([^\]]+)/INFO\]: (.*)$")
ANSI = re.compile(r"\x1b\[[0-9;]*m")
JOIN = re.compile(r"^(\S+) joined the game$")
LEAVE = re.compile(r"^(\S+) left the game$")
ADV = re.compile(r"^(\S+) has (?:made the advancement|completed the challenge|reached the goal) \[(.+)\]$")
CHAT = re.compile(r"^(?:\[Not Secure\] )?<([^>\s]+)> (.*)$")
DEATH = re.compile(r"^(\S+) (was |died|drowned|blew up|burned|fell |hit the ground|went up in flames|walked into|"
                   r"tried to swim|experienced kinetic|froze|starved|suffocated|withered|discovered the floor|"
                   r"didn't want to live|left the confines|went off with)")
START = re.compile(r"^Done \([\d.]+s\)! For help")
STOP = "Stopping server"
_parsed = {}  # rotated log name -> events (those files never change)


def parse_log(path, base, backwards):
    """Events in one log. Lines only carry a time; the date is the file's date, plus a
    day each time the clock wraps past midnight. For latest.log the date is counted
    back from its modification time (the time of its last line)."""
    opener = gzip.open if path.endswith(".gz") else open
    try:
        with opener(path, "rt", encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return []
    rows, prev, day = [], -1, 0
    for raw in lines:
        m = LINE.match(ANSI.sub("", raw))
        if not m:
            continue
        secs = int(m[1]) * 3600 + int(m[2]) * 60 + int(m[3])
        if secs < prev:
            day += 1
        prev = secs
        rows.append((day, secs, m[4], m[5]))
    if backwards and rows:
        base -= dt.timedelta(days=rows[-1][0])
    out = []
    for day, secs, thread, msg in rows:
        t = time.mktime((base + dt.timedelta(days=day)).timetuple()) + secs
        ev = classify(thread, msg)
        if ev:
            out.append({"t": t, **ev})
    return out


def classify(thread, msg):
    if thread.startswith("Async Chat Thread"):
        if m := CHAT.match(msg):
            return {"type": "chat", "name": m[1], "text": m[2]}
        return None
    if thread != "Server thread":
        return None
    if m := JOIN.match(msg):
        return {"type": "join", "name": m[1], "text": "joined"}
    if m := LEAVE.match(msg):
        return {"type": "leave", "name": m[1], "text": "left"}
    if m := ADV.match(msg):
        return {"type": "advancement", "name": m[1], "text": m[2]}
    if m := DEATH.match(msg):
        return {"type": "death", "name": m[1], "text": msg[len(m[1]) + 1:]}
    if START.match(msg):
        return {"type": "server", "name": None, "text": "Server started"}
    if msg == STOP:
        return {"type": "server", "name": None, "text": "Server stopped"}
    return None


def all_events():
    files = []
    for f in os.listdir(LOGS):
        if m := re.match(r"^(\d{4})-(\d\d)-(\d\d)-(\d+)\.log\.gz$", f):
            files.append(((m[1], m[2], m[3], int(m[4])), f))
    events = []
    for _, f in sorted(files):
        if f not in _parsed:
            base = dt.datetime.strptime(f[:10], "%Y-%m-%d")
            _parsed[f] = parse_log(f"{LOGS}/{f}", base, False)
        events += _parsed[f]
    latest = f"{LOGS}/latest.log"
    if os.path.exists(latest):
        mday = dt.datetime.fromtimestamp(os.path.getmtime(latest)).replace(hour=0, minute=0, second=0, microsecond=0)
        events += parse_log(latest, mday, True)
    # Death regex can match a non-player line ("Zombie was ..."); keep only names that joined
    joined = {e["name"] for e in events if e["type"] == "join"}
    return [e for e in events if e["type"] != "death" or e["name"] in joined]


def sessions(events, running, now):
    """[(name, start, end, still_online)] from join/leave pairs. A server stop or
    crash (next start without a stop) ends everyone's session."""
    out, open_, last = [], {}, None
    for e in events:
        if e["type"] == "join":
            open_[e["name"]] = e["t"]
        elif e["type"] == "leave" and e["name"] in open_:
            out.append((e["name"], open_.pop(e["name"]), e["t"], False))
        elif e["type"] == "server":
            end = e["t"] if e["text"] == "Server stopped" else (last or e["t"])
            out += [(n, s, end, False) for n, s in open_.items()]
            open_ = {}
        last = e["t"]
    out += [(n, s, now if running else last, running) for n, s in open_.items()]
    return out


# --- Player files ------------------------------------------------------------

def load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def player_stats(uuid):
    s = load_json(f"{WORLD}/players/stats/{uuid}.json", {}).get("stats", {})
    c = s.get("minecraft:custom", {})
    adv = load_json(f"{WORLD}/players/advancements/{uuid}.json", {})
    return {
        "play_ticks": c.get("minecraft:play_time", 0),
        "deaths": c.get("minecraft:deaths", 0),
        "mob_kills": c.get("minecraft:mob_kills", 0),
        "distance_cm": sum(v for k, v in c.items() if k.endswith("_one_cm")
                           and k not in ("minecraft:fall_one_cm", "minecraft:fly_one_cm")),
        "blocks_mined": sum(s.get("minecraft:mined", {}).values()),
        "advancements": sum(1 for k, v in adv.items() if isinstance(v, dict) and v.get("done")
                            and not k.startswith("minecraft:recipes/")),
    }


def essentials_times(uuid):
    try:
        with open(f"{LIVE}/plugins/Essentials/userdata/{uuid}.yml") as fh:
            text = fh.read()
    except OSError:
        return {}
    out = {}
    for k in ("login", "logout"):
        if m := re.search(rf"^  {k}: (\d+)$", text, re.M):
            out[k] = int(m[1]) / 1000
    return out


# --- Machine -----------------------------------------------------------------

_world_size = (0, 0)


def world_bytes():
    global _world_size
    if time.time() - _world_size[0] > 900:
        total = 0
        for root, _, names in os.walk(WORLD):
            for n in names:
                try:
                    total += os.lstat(os.path.join(root, n)).st_size
                except OSError:
                    pass
        _world_size = (time.time(), total)
    return _world_size[1]


def machine():
    out = {}
    try:
        pid = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", SERVICE],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        with open(f"/proc/{pid}/status") as fh:
            out["mem_rss"] = int(re.search(r"^VmRSS:\s+(\d+) kB", fh.read(), re.M)[1]) * 1024
    except (OSError, subprocess.SubprocessError, TypeError, ValueError):
        pass
    try:
        with open("/proc/loadavg") as fh:
            out["load"] = float(fh.read().split()[0])
        out["cpus"] = os.cpu_count()
        with open("/proc/meminfo") as fh:
            mi = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in fh)}
        out["ram_total"], out["ram_free"] = mi["MemTotal"], mi["MemAvailable"]
        st = os.statvfs(LIVE)
        out["disk_total"], out["disk_free"] = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
    except (OSError, KeyError, ValueError):
        pass
    out["world_bytes"] = world_bytes()
    try:
        out["world_zip_time"] = os.path.getmtime(WORLD_ZIP)
    except OSError:
        pass
    return out


# --- Snapshot ----------------------------------------------------------------

def snapshot():
    now = time.time()
    server = {"up": False}
    try:
        p = ping()
        desc = p.get("description", "")
        server = {"up": True, "version": p.get("version", {}).get("name"),
                  "online": p.get("players", {}).get("online", 0), "max": p.get("players", {}).get("max", 0),
                  "motd": desc.get("text", "") if isinstance(desc, dict) else str(desc),
                  "sample": [s["name"] for s in p.get("players", {}).get("sample", [])]}
    except (OSError, ValueError):
        pass

    events = all_events()
    sess = sessions(events, server["up"], now)
    starts = [e["t"] for e in events if e["type"] == "server" and e["text"] == "Server started"]
    if server["up"] and starts:
        server["since"] = starts[-1]

    # Players: everyone the server has cached or kept stats for
    names = {e["uuid"]: e["name"] for e in load_json(f"{LIVE}/usercache.json", [])}
    try:
        for f in os.listdir(f"{WORLD}/players/stats"):
            if f.endswith(".json"):
                names.setdefault(f[:-5], f[:8])
    except OSError:
        pass
    ops = {o.get("uuid") for o in load_json(f"{LIVE}/ops.json", [])}
    banned = {b.get("uuid") for b in load_json(f"{LIVE}/banned-players.json", [])}
    by_name = {}
    for name, start, end, online in sess:
        by_name.setdefault(name, []).append((start, end, online))

    players = []
    for uuid, name in names.items():
        mine = sorted(by_name.get(name, []))
        ess = essentials_times(uuid)
        online = bool(mine and mine[-1][2]) or name in server.get("sample", [])
        last = max([e for _, e, o in mine if not o] + [ess.get("logout", 0)]) or None
        players.append({
            "name": name, "uuid": uuid, "bedrock": uuid.startswith("00000000-0000-0000-"),
            "online": online, "online_since": mine[-1][0] if online and mine else None,
            "first_seen": mine[0][0] if mine else ess.get("login"),
            "last_seen": now if online else last,
            "last_session": (mine[-1][1] - mine[-1][0]) if mine else None,
            "sessions": len(mine), "op": uuid in ops, "banned": uuid in banned,
            "week_secs": sum(max(0, e - max(s, now - 7 * 86400)) for s, e, _ in mine),
            **player_stats(uuid),
        })

    # Daily activity: player-hours (sessions split at midnight) and distinct players
    today = dt.date.today()
    days = {today - dt.timedelta(days=i): [0.0, set()] for i in range(DAYS)}
    for name, start, end, _ in sess:
        t = start
        while t < end:
            d = dt.date.fromtimestamp(t)
            nxt = min(end, time.mktime((d + dt.timedelta(days=1)).timetuple()))
            if d in days:
                days[d][0] += nxt - t; days[d][1].add(name)
            t = nxt
    daily = [{"date": d.isoformat(), "hours": round(v[0] / 3600, 2), "players": sorted(v[1])}
             for d, v in sorted(days.items())]

    week = now - 7 * 86400
    return {
        "generated": now, "server": server, "machine": machine(),
        "players": players, "daily": daily, "events": events[-FEED:][::-1],
        "week": {
            "players": len({n for n, s, e, _ in sess if e >= week}),
            "hours": round(sum(p["week_secs"] for p in players) / 3600, 1),
            "deaths": sum(1 for e in events if e["type"] == "death" and e["t"] >= week),
            "advancements": sum(1 for e in events if e["type"] == "advancement" and e["t"] >= week),
            "new": sum(1 for p in players if p["first_seen"] and p["first_seen"] >= week),
        },
    }


_lock, _cached = threading.Lock(), (0, b"")


def cached_json():
    global _cached
    with _lock:
        if time.time() - _cached[0] > CACHE:
            _cached = (time.time(), json.dumps(snapshot()).encode())
        return _cached[1]


# --- HTTP --------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            ip = ipaddress.ip_address(self.client_address[0])
            ip = getattr(ip, "ipv4_mapped", None) or ip
            if not (ip.is_private or ip.is_loopback):
                return self.send_error(403, "Home network only")
        except ValueError:
            return self.send_error(403)
        path = self.path.split("?")[0]
        if path == "/api/status":
            try:
                body, ctype = cached_json(), "application/json"
            except Exception as e:  # keep the page alive; show the error there
                self.log_error("snapshot failed: %r", e)
                return self.send_error(500, "Could not read server data")
        elif path in ("/", "/index.html"):
            body, ctype = PAGE.encode(), "text/html; charset=utf-8"
        else:
            return self.send_error(404)
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass  # requests every 15s would flood the journal


class Server(ThreadingHTTPServer):
    address_family = socket.AF_INET6
    daemon_threads = True

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


