<script>
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const num = n => Number(n || 0).toLocaleString();
const bytes = b => b == null ? "–" : b >= 1e9 ? (b / 1e9).toFixed(1) + " GB" : (b / 1e6).toFixed(0) + " MB";
const dur = s => { s = Math.max(0, s || 0); const d = Math.floor(s / 86400), h = Math.floor(s / 3600) % 24, m = Math.floor(s / 60) % 60;
  return d ? `${d}d ${h}h` : h ? `${h}h ${m}m` : m ? `${m}m` : "<1m"; };
const hours = ticks => (ticks / 72000).toFixed(1) + " h";
const km = cm => cm >= 100000 ? (cm / 100000).toFixed(1) + " km" : Math.round(cm / 100) + " m";
function ago(t) {
  if (!t) return "–";
  const s = Date.now() / 1000 - t;
  if (s < 90) return "just now";
  if (s < 3600) return Math.round(s / 60) + " min ago";
  if (s < 86400) return Math.round(s / 3600) + " h ago";
  if (s < 86400 * 14) { const n = Math.round(s / 86400); return n === 1 ? "yesterday" : n + " days ago"; }
  return new Date(t * 1000).toLocaleDateString(undefined, {day: "numeric", month: "short"});
}
const clock = t => new Date(t * 1000).toLocaleTimeString(undefined, {hour: "2-digit", minute: "2-digit"});
function head(p) {
  // Bedrock players have no Java skin, so only Java UUIDs get a face
  return p && !p.bedrock ? `<img class="head" alt="" loading="lazy" src="https://mc-heads.net/avatar/${p.uuid}/24" onerror="this.style.visibility='hidden'">`
    : `<span class="head"></span>`;
}

let data = null, filter = "all", sortKey = "last_seen", sortAsc = false;

function render() {
  const d = data, s = d.server, byName = Object.fromEntries(d.players.map(p => [p.name, p]));
  const st = $("status");
  st.className = "status " + (s.up ? "up" : "down");
  st.lastElementChild.textContent = s.up ? `Online · ${s.version || ""}` : "Offline";
  $("meta").textContent = "Updated " + clock(d.generated);

  const total = d.players.reduce((a, p) => a + p.play_ticks, 0);
  const tiles = [
    ["Players online", s.up ? `${s.online} / ${s.max}` : "–", s.up && s.since ? "up for " + dur(d.generated - s.since) : ""],
    ["Players this week", d.week.players, d.week.new ? `${d.week.new} new` : "no new players"],
    ["Hours played this week", d.week.hours, ""],
    ["Deaths this week", d.week.deaths, ""],
    ["Advancements this week", d.week.advancements, ""],
    ["All players", d.players.length, hours(total) + " played in total"],
  ];
  $("tiles").innerHTML = tiles.map(([l, v, sub]) =>
    `<div class="card tile"><div class="label">${l}</div><div class="value">${esc(v)}</div><div class="sub">${esc(sub)}</div></div>`).join("");

  const online = d.players.filter(p => p.online).sort((a, b) => (a.online_since || 0) - (b.online_since || 0));
  $("online-title").textContent = `Online now (${s.up ? s.online : 0})`;
  $("online").innerHTML = online.length ? online.map(p =>
    `<li>${head(p)}<span class="name">${esc(p.name)}</span>${p.op ? ' <span class="tag">op</span>' : ""}
     <span class="right">${p.online_since ? "on for " + dur(d.generated - p.online_since) : ""}</span></li>`).join("")
    : `<li class="empty">${s.up ? "Nobody's on right now." : "The server is offline."}</li>`;

  const recent = d.players.filter(p => p.last_seen).sort((a, b) => b.last_seen - a.last_seen).slice(0, 8);
  $("recent").innerHTML = recent.map(p =>
    `<li>${head(p)}<span class="name">${esc(p.name)}</span>${p.online ? ' <span class="tag on">online</span>' : ""}
     <span class="right">${p.online ? "now" : ago(p.last_seen)}<br><span style="color:var(--muted);font-size:12px">${
       p.last_session ? "last session " + dur(p.last_session) : ""}</span></span></li>`).join("") || `<li class="empty">No one yet.</li>`;

  renderChart();
  renderFeed(byName);
  renderMachine();
  renderTable();
}

function renderChart() {
  const svg = $("chart"), days = data.daily, W = svg.clientWidth || 600, H = 190, L = 34, B = 22, T = 8;
  const max = Math.max(1, ...days.map(d => d.hours));
  const step = max <= 4 ? 1 : max <= 10 ? 2 : max <= 25 ? 5 : 10, top = Math.ceil(max / step) * step;
  const y = v => T + (H - T - B) * (1 - v / top), bw = (W - L) / days.length, gap = Math.min(4, bw * 0.25);
  let g = '<g class="axis">';
  for (let v = 0; v <= top; v += step) g += `<line x1="${L}" x2="${W}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${v}</text>`;
  days.forEach((d, i) => { if (i % 5 === (days.length - 1) % 5) {
    const dd = new Date(d.date + "T12:00");
    g += `<text x="${L + i * bw + bw / 2}" y="${H - 4}" text-anchor="middle">${dd.toLocaleDateString(undefined, {day: "numeric", month: "short"})}</text>`; } });
  g += "</g>";
  days.forEach((d, i) => {
    const x = L + i * bw + gap / 2, w = bw - gap, h = y(0) - y(d.hours), r = Math.min(4, w / 2, h);
    g += `<rect class="hit" data-i="${i}" x="${L + i * bw}" y="${T}" width="${bw}" height="${H - T - B}" fill="transparent"/>`;
    g += d.hours > 0 ? `<path class="bar" data-i="${i}" d="M${x},${y(0)} V${y(d.hours) + r} q0,-${r} ${r},-${r} H${x + w - r} q${r},0 ${r},${r} V${y(0)} Z"/>` : "<g></g>";
  });
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  svg.innerHTML = g;
  const tip = $("tip");
  svg.querySelectorAll(".hit").forEach(el => {
    el.addEventListener("mouseenter", () => {
      const d = days[+el.dataset.i], dd = new Date(d.date + "T12:00");
      tip.innerHTML = `<b>${dd.toLocaleDateString(undefined, {weekday: "short", day: "numeric", month: "short"})}</b><br>${d.hours.toFixed(1)} h played` +
        (d.players.length ? `<br>${d.players.map(esc).join(", ")}` : "<br>nobody played");
      const x = (+el.getAttribute("x") + bw / 2) / W * svg.clientWidth;
      tip.style.left = Math.min(Math.max(x, 90), svg.clientWidth - 90) + "px";
      tip.style.top = (y(d.hours) / H * svg.clientHeight - 6) + "px";
      tip.style.display = "block";
    });
    el.addEventListener("mouseleave", () => tip.style.display = "none");
  });
}

const ICONS = {join: "🟢", leave: "⚪", death: "💀", advancement: "🏆", chat: "💬", server: "🖥️"};
const KINDS = [["all", "All"], ["players", "Joins & leaves"], ["death", "Deaths"], ["advancement", "Advancements"], ["chat", "Chat"], ["server", "Server"]];
function renderFeed(byName) {
  $("filters").innerHTML = KINDS.map(([k, l]) => `<button data-k="${k}" aria-pressed="${k === filter}">${l}</button>`).join("");
  $("filters").querySelectorAll("button").forEach(b => b.onclick = () => { filter = b.dataset.k; renderFeed(byName); });
  const ok = e => filter === "all" || e.type === filter || (filter === "players" && (e.type === "join" || e.type === "leave"));
  let html = "", lastDay = "";
  for (const e of data.events.filter(ok).slice(0, 120)) {
    const day = new Date(e.t * 1000).toLocaleDateString(undefined, {weekday: "long", day: "numeric", month: "short"});
    if (day !== lastDay) { html += `<li class="ev-day">${day}</li>`; lastDay = day; }
    const text = e.type === "chat" ? `<span class="name">${esc(e.name)}</span>: ${esc(e.text)}`
      : e.type === "advancement" ? `<span class="name">${esc(e.name)}</span> got <b>${esc(e.text)}</b>`
      : e.type === "server" ? esc(e.text)
      : `<span class="name">${esc(e.name)}</span> ${esc(e.text)}`;
    html += `<li><span class="ev-icon">${ICONS[e.type]}</span><span class="ev-text">${text}</span><span class="ev-time">${clock(e.t)}</span></li>`;
  }
  $("feed").innerHTML = html || `<li class="empty">Nothing yet.</li>`;
}

function renderMachine() {
  const m = data.machine, s = data.server;
  const rows = [
    ["Status", s.up ? `Online, up for ${s.since ? dur(data.generated - s.since) : "?"}` : "Offline"],
    ["Version", s.version || "–"],
    ["Server memory", m.mem_rss ? bytes(m.mem_rss) + " used (4 GB max)" : "–"],
    ["Machine RAM", m.ram_total ? `${bytes(m.ram_total - m.ram_free)} of ${bytes(m.ram_total)}` : "–"],
    ["CPU load", m.load != null ? `${m.load.toFixed(2)} (${m.cpus} cores)` : "–"],
    ["World size", bytes(m.world_bytes)],
    ["Disk free", m.disk_free ? `${bytes(m.disk_free)} of ${bytes(m.disk_total)}` : "–"],
    ["World download refreshed", m.world_zip_time ? ago(m.world_zip_time) : "–"],
  ];
  $("machine").innerHTML = rows.map(([k, v]) => `<li><span style="color:var(--text-2)">${k}</span><span class="right">${esc(v)}</span></li>`).join("");
}

const COLS = [
  ["name", "Player"], ["last_seen", "Last seen"], ["first_seen", "First joined"], ["play_ticks", "Played"],
  ["week_secs", "This week"], ["sessions", "Sessions"], ["deaths", "Deaths"], ["mob_kills", "Mobs killed"],
  ["blocks_mined", "Blocks mined"], ["distance_cm", "Distance"], ["advancements", "Advancements"],
];
function renderTable() {
  const ps = [...data.players].sort((a, b) => {
    const x = a[sortKey] ?? -1, y = b[sortKey] ?? -1;
    const c = typeof x === "string" ? x.localeCompare(y, undefined, {sensitivity: "base"}) : x - y;
    return sortAsc ? c : -c;
  });
  $("pcount").textContent = "· " + ps.length;
  const tr = $("players").tHead.rows[0];
  tr.innerHTML = COLS.map(([k, l]) => `<th data-k="${k}"${k === sortKey ? ` aria-sort="${sortAsc ? "ascending" : "descending"}"` : ""}>${l}</th>`).join("");
  tr.querySelectorAll("th").forEach(th => th.onclick = () => {
    if (sortKey === th.dataset.k) sortAsc = !sortAsc; else { sortKey = th.dataset.k; sortAsc = sortKey === "name"; }
    renderTable();
  });
  $("players").tBodies[0].innerHTML = ps.map(p => `<tr>
    <td><span class="who">${head(p)}<span class="name">${esc(p.name)}</span>${p.online ? '<span class="tag on">online</span>' : ""}${
      p.op ? '<span class="tag">op</span>' : ""}${p.bedrock ? '<span class="tag">bedrock</span>' : ""}${p.banned ? '<span class="tag">banned</span>' : ""}</span></td>
    <td>${p.online ? "now" : ago(p.last_seen)}</td>
    <td>${p.first_seen ? new Date(p.first_seen * 1000).toLocaleDateString(undefined, {day: "numeric", month: "short"}) : "–"}</td>
    <td>${hours(p.play_ticks)}</td><td>${p.week_secs ? dur(p.week_secs) : "–"}</td><td>${num(p.sessions)}</td>
    <td>${num(p.deaths)}</td><td>${num(p.mob_kills)}</td><td>${num(p.blocks_mined)}</td><td>${km(p.distance_cm)}</td><td>${num(p.advancements)}</td>
  </tr>`).join("");
}

async function load() {
  try {
    const r = await fetch("/api/status", {cache: "no-store"});
    if (!r.ok) throw new Error(r.status + " " + r.statusText);
    data = await r.json();
    $("err").style.display = "none";
    render();
  } catch (e) {
    $("err").textContent = "Couldn't load server data (" + e.message + "). Retrying…";
    $("err").style.display = "block";
  }
}
load();
setInterval(load, 15000);
let rt; addEventListener("resize", () => { clearTimeout(rt); rt = setTimeout(() => data && renderChart(), 150); });
</script>
</body>
</html>
"""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8200)
    ap.add_argument("--dump", action="store_true")
    a = ap.parse_args()
    if a.dump:
        json.dump(snapshot(), sys.stdout, indent=1); print()
        return
    srv = Server(("::", a.port), Handler)
    print(f"dashboard on port {a.port}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
